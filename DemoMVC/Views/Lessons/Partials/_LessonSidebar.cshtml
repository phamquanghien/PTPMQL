@model DemoMVC.Models.Lesson
@using DemoMVC.Data
<div class="card border-0 shadow-sm lesson-sidebar">
    <div class="card-body p-3 p-lg-4">
        <!-- Header -->
        <div class="d-flex align-items-center mb-3">
            <div class="me-2 text-primary">
                <i class="bi bi-book fs-5"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-0">
                    Nội dung học phần
                </h5>
                <small class="text-secondary">
                    Phát triển phần mềm quản lý
                </small>
            </div>
        </div>
        <hr />
        <!-- Course sections -->
        @foreach (var chapter in LearningData.Lessons
            .GroupBy(x => new
            {
                x.ChapterId,
                x.ChapterTitle
            })
            .OrderBy(x => x.Key.ChapterId))
        {
            <div class="lesson-chapter mb-4">
                <!-- Chapter title -->
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold small text-primary">
                        @chapter.Key.ChapterId.ToString("D2").
                        @chapter.Key.ChapterTitle
                    </span>
                    <span class="badge rounded-pill text-bg-light">
                        @chapter.Count()
                    </span>
                </div>
                <!-- Lessons -->
                <div class="list-group list-group-flush">
                    @foreach (var lesson in chapter.OrderBy(x => x.Order))
                    {
                        var isActive = lesson.Id == Model.Id;
                        <a asp-controller="Lessons" asp-action="Detail" asp-route-id="@lesson.Id" class="list-group-item
                            list-group-item-action
                            border-0
                            rounded
                            px-2
                            py-2
                            @(isActive ? "active" : "")">
                            <div class="d-flex align-items-start">
                                <!-- Icon -->
                                <span class="me-2 flex-shrink-0">
                                    @if (isActive)
                                    {
                                        <i class="bi bi-play-circle-fill"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-circle"></i>
                                    }
                                </span>
                                <!-- Lesson information -->
                                <div class="small">
                                    <div class="@(isActive ? "fw-semibold" : "")">
                                        @lesson.Title
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>