@{
    ViewData["Title"] = "Phát triển phần mềm quản lý";
}
<div class="container py-5">
    <!-- Header -->
    <div class="row mb-4">
        <div class="col-lg-8">
            <span class="badge text-bg-primary mb-2">
                ASP.NET Core MVC
            </span>
            <h1 class="fw-bold">
                Học phần Phát triển phần mềm quản lý
            </h1>
            <p class="text-secondary">
                Học xây dựng website quản lý trên nền tảng .NET MVC
            </p>
        </div>
    </div>
    <!-- Course sections -->
    <div class="row g-4">
        <!-- Section 1 -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <h4 class="fw-bold mb-1">
                                01. Overview
                            </h4>
                            <small class="text-secondary">
                                4 bài học
                            </small>
                        </div>
                        <span class="badge rounded-pill text-bg-light">
                            Cơ bản
                        </span>
                    </div>
                    <div class="list-group list-group-flush">
                        <a asp-action="Detail" asp-route-id="1" class="list-group-item list-group-item-action py-3">
                            <div class="d-flex">
                                <span class="me-3 text-primary">
                                    <i class="bi bi-play-circle"></i>
                                </span>
                                <div>
                                    <strong>
                                        Hình thức học tập và thi kết thúc học phần
                                    </strong>
                                </div>
                            </div>
                        </a>
                        <a asp-action="Detail" asp-route-id="2" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Công nghệ sử dụng
                        </a>
                        <a asp-action="Detail" asp-route-id="3" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Cài đặt và thiết lập môi trường lập trình
                        </a>
                        <a asp-action="Detail" asp-route-id="4" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Thiết lập quy trình CICD
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <!-- Section 2 -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h4 class="fw-bold mb-1">
                        02. .NET MVC
                    </h4>
                    <p class="text-secondary">
                        5 bài học
                    </p>
                    <div class="list-group list-group-flush">
                        <a asp-action="Detail" asp-route-id="5" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            MVC Pattern
                        </a>
                        <a asp-action="Detail" asp-route-id="6" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Routing
                        </a>
                        <a asp-action="Detail" asp-route-id="7" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Controller, Model, View
                        </a>
                        <a asp-action="Detail" asp-route-id="8" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Quản lý trạng thái
                        </a>
                        <a asp-action="Detail" asp-route-id="9" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Layout, Partial View, View Component
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <!-- Section 3 -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h4 class="fw-bold">
                        03. Database
                    </h4>
                    <p class="text-secondary">
                        7 bài học
                    </p>
                    <div class="list-group list-group-flush">
                        <a asp-action="Detail" asp-route-id="10" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Thiết lập kết nối CSDL
                        </a>
                        <a asp-action="Detail" asp-route-id="11" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Migration
                        </a>
                        <a asp-action="Detail" asp-route-id="12" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            CRUD
                        </a>
                        <a asp-action="Detail" asp-route-id="13" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            LINQ
                        </a>
                        <a asp-action="Detail" asp-route-id="14" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            AJAX CRUD
                        </a>
                        <a asp-action="Detail" asp-route-id="15" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Excel
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <!-- Section 4 -->
        <div class="col-12">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <h4 class="fw-bold">
                        04. Authentication & Authorization
                    </h4>
                    <p class="text-secondary">
                        4 bài học
                    </p>
                    <div class="list-group list-group-flush">
                        <a asp-action="Detail" asp-route-id="16" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Login / Register
                        </a>
                        <a asp-action="Detail" asp-route-id="17" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            ASP.NET Core Identity
                        </a>
                        <a asp-action="Detail" asp-route-id="18" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Authentication
                        </a>
                        <a asp-action="Detail" asp-route-id="19" class="list-group-item list-group-item-action py-3">
                            <i class="bi bi-play-circle text-primary me-3"></i>
                            Authorization
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>