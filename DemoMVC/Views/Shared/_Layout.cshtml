<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
        @ViewData["Title"] PTPMQL
    </title>
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/lesson.css" asp-append-version="true" />
</head>
<body>
    <!-- =====================================================
         NAVBAR
    ====================================================== -->
    <header>
        <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
            <div class="container-fluid px-lg-4">
                <!-- Logo -->
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-icon">
                        <i class="bi bi-code-square"></i>
                    </span>
                    <span>
                        <strong>.NET</strong>
                        <span class="text-primary">MVC</span>
                        <small class="d-block text-secondary">
                            Phát triển Phần mềm Quản lý
                        </small>
                    </span>
                </a>
                <!-- Mobile toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <!-- Navigation -->
                <partial name="_Navigation" />
            </div>
        </nav>
    </header>
    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->
    <main>
        @RenderBody()
    </main>
    <!-- =====================================================
         FOOTER
    ====================================================== -->
    <footer class="border-top bg-white mt-5">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-6">
                    <strong>
                        Phát triển phần mềm quản lý (7080638) - 2026
                    </strong>
                </div>
            </div>
        </div>
    </footer>
    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>
    <script src="~/js/site.js" asp-append-version="true">
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>